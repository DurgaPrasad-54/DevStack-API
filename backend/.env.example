# ─────────────────────────────────────────────────────────────
# DevStack Backend — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development    # development | production

# ─── Database ─────────────────────────────────────────────────
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── JWT Security ──────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_SECRET
SESSION_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET

# ─── CORS / Frontend ───────────────────────────────────────────
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Production example:
# FRONTEND_URL=https://your-production-domain.com

# ─── Email (Gmail App Password) ────────────────────────────────
# Use a dedicated service account, NOT a personal gmail.
# Enable 2FA then create an App Password at: myaccount.google.com/apppasswords
GMAIL_USER=your-service-account@gmail.com
GMAIL_PASS=your-16-char-app-password

# ─── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info    # debug | info | warn | error

# ─── Redis (optional — required for horizontal scaling) ────────
# REDIS_URL=redis://localhost:6379
