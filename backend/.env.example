# DevStack Backend - Environment Variables

# Application
NODE_ENV=production
PORT=5000

# Frontend URL (for CORS)
FRONTEND_URL=https://yourdomain.com

# MongoDB Connection
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/devstack?retryWrites=true&w=majority

# Authentication
SECRET_KEY=your-very-secure-secret-key-change-this-in-production

# Email Configuration
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=your-app-password

# Admin Credentials
ADMIN_USER=admin@example.com
ADMIN_PASS=admin-password

# Logging
LOG_LEVEL=info

# Session
SESSION_SECRET=your-session-secret-key
